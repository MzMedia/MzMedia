# 复制为 .env 后修改：cp .env.example .env
# 以下密码仅为示例，部署前请替换；.env 已被 .gitignore 忽略，不要提交

## 前端 Nginx 对宿主机开放的端口
WEB_PORT=8080

## 后端镜像 tag（每次重新打包后可修改，便于回滚）
IMAGE_TAG=local

## MySQL（首次初始化时生效，已有数据卷后修改不会改变库内账号密码）
MYSQL_DATABASE=mzmedia
MYSQL_ROOT_PASSWORD=Root@ChangeMe2026
MYSQL_USER=yudao
MYSQL_PASSWORD=Yudao@ChangeMe2026

## Redis
REDIS_PASSWORD=Redis@ChangeMe2026

## TDengine（IoT 物联网时序数据库，库名必须使用下划线不能包含中划线）
TDENGINE_DATABASE=mzmedia
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata

## 后端应用
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
# 需与前端打包时的 VITE_APP_CAPTCHA_ENABLE 一致
YUDAO_CAPTCHA_ENABLE=true

## 流媒体服务 (ZLMediaKit)
MEDIA_SECRET=mzmedia_zlm_secret_2026_test_key
ZLM_HTTP_PORT=18080
ZLM_HTTPS_PORT=18443
ZLM_RTSP_PORT=8554
ZLM_RTMP_PORT=19350
ZLM_RTC_PORT=8005
ZLM_RTP_PORT=10005
