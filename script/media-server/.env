# ==============================================================================
# 流媒体测试环境配置 (.env)
# ==============================================================================

# 流媒体服务器与 MzMedia 交互公用 REST Secret
MEDIA_SECRET=mzmedia_zlm_secret_2026_test_key

# MzMedia 后端服务地址（供流媒体服务器触发 Webhook 回调）
# 本机宿主机运行（如 IDEA 调试）：填 host.docker.internal
# 如果在统一 Docker 桥接网络中运行：填 yudao-server
HOOK_HOST=host.docker.internal
HOOK_PORT=48080

# 宿主机 IP（用于流媒体客户端拉流与 WebRTC 地址拼接，建议填本机局域网 IP 如 192.168.x.x）
SERVER_IP=127.0.0.1

# ------------------------------------------------------------------------------
# ZLMediaKit (ZLM) 端口配置（使用独立非冲突端口，如需标准端口 554/1935 可自行按需修改）
# ------------------------------------------------------------------------------
ZLM_HTTP_PORT=18080
ZLM_HTTPS_PORT=18443
ZLM_RTSP_PORT=8554
ZLM_RTMP_PORT=19350
ZLM_RTC_PORT=8005
ZLM_RTP_PORT=10005

# ------------------------------------------------------------------------------
# ABLMediaServer (ABL) 端口配置
# ------------------------------------------------------------------------------
ABL_HTTP_PORT=9000
ABL_FLV_PORT=9001
ABL_WS_PORT=9002
ABL_MP4_PORT=9003
ABL_HLS_PORT=9004
ABL_RTSP_PORT=5544
ABL_RTMP_PORT=1936
ABL_RTP_PORT=10002
ABL_JT_PORT=7078
ABL_RTC_PORT=8289
